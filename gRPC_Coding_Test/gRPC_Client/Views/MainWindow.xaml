<Window x:Class="gRPC_Client.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="gRPC Rechner" Height="360" Width="460" MinHeight="360" MinWidth="460">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Label Grid.Row="0" Grid.Column="0" Content="Erste Zahl:" VerticalAlignment="Center" />
        <TextBox x:Name="LeftOperandTextBox" Grid.Row="0" Grid.Column="1" PreviewTextInput="NumberTextBox_PreviewTextInput" DataObject.Pasting="NumberTextBox_Pasting" />
        <Label Grid.Row="2" Grid.Column="0" Content="Operation:" VerticalAlignment="Center" />
        <ComboBox x:Name="OperationComboBox" Grid.Row="2" Grid.Column="1" SelectedIndex="0">
            <ComboBoxItem Content="Addition" Tag="addition" />
            <ComboBoxItem Content="Subtraktion" Tag="subtraction" />
            <ComboBoxItem Content="Multiplikation" Tag="multiplication" />
            <ComboBoxItem Content="Division" Tag="division" />
        </ComboBox>
        <Label Grid.Row="4" Grid.Column="0" Content="Zweite Zahl:" VerticalAlignment="Center" />
        <TextBox x:Name="RightOperandTextBox" Grid.Row="4" Grid.Column="1" PreviewTextInput="NumberTextBox_PreviewTextInput" DataObject.Pasting="NumberTextBox_Pasting" />
        <Button Grid.Row="6" Grid.Column="1" Width="120" HorizontalAlignment="Left" Content="Absenden" Click="SubmitButton_Click" />
        <Label Grid.Row="8" Grid.Column="0" Content="Antwort:" VerticalAlignment="Top" />
        <TextBox x:Name="ResponseTextBox" Grid.Row="8" Grid.Column="1" IsReadOnly="True" IsTabStop="False" Focusable="False" TextWrapping="Wrap" MinHeight="48" VerticalContentAlignment="Center" />
    </Grid>
</Window>
